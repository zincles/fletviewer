{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build fvcore",
      "type": "process",
      "command": "cargo",
      "args": [
        "build",
        "--bin",
        "fvcore"
      ],
      "options": {
        "cwd": "${workspaceFolder}/fvcore"
      },
      "problemMatcher": [
        "$rustc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
